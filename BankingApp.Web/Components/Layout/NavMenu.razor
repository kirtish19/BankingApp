
@using BankingApp.Web.Services.Authentication

@inject IAuthStorageService AuthStorageService
@inject IAuthenticationService AuthenticationService
@inject NavigationManager Navigation


<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

    <div class="container-fluid px-4">

        <!-- Brand -->
        <a class="navbar-brand fw-bold fs-4"
           href="/">
            BankingApp
        </a>


        <!-- Mobile Toggle -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#bankingNavbar"
                aria-controls="bankingNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>


        <!-- Navigation -->
        <div class="collapse navbar-collapse"
             id="bankingNavbar">

            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                <!-- Home -->
                <li class="nav-item">

                    <NavLink class="nav-link px-3"
                             href="/"
                             Match="NavLinkMatch.All">

                        <i class="bi bi-house-door-fill me-1"></i>
                        Home

                    </NavLink>

                </li>


                @if (IsLoggedIn)
                {
                    <!-- Dashboard -->
                    <li class="nav-item">

                        <NavLink class="nav-link px-3"
                                 href="@DashboardUrl">

                            <i class="bi bi-speedometer2 me-1"></i>
                            Dashboard

                        </NavLink>

                    </li>


                    <!-- Logout -->
                    <li class="nav-item">

                        <button type="button"
                                class="btn btn-link nav-link px-3"
                                @onclick="Logout">

                            <i class="bi bi-box-arrow-right me-1"></i>
                            Logout

                        </button>

                    </li>
                }
                else
                {
                    <!-- Login -->
                    <li class="nav-item">

                        <NavLink class="nav-link px-3"
                                 href="/login">

                            <i class="bi bi-box-arrow-in-right me-1"></i>
                            Login

                        </NavLink>

                    </li>


                    <!-- Register -->
                    <li class="nav-item">

                        <NavLink class="nav-link px-3"
                                 href="/register">

                            <i class="bi bi-person-plus-fill me-1"></i>
                            Register

                        </NavLink>

                    </li>
                }

            </ul>

        </div>

    </div>

</nav>


@code {

    private bool IsLoggedIn;

    private string DashboardUrl =
        "/customer-dashboard";


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadAuthenticationState();

        StateHasChanged();
    }


    private async Task LoadAuthenticationState()
    {
        IsLoggedIn =
            await AuthStorageService.IsSessionValidAsync();


        if (!IsLoggedIn)
        {
            return;
        }


        var customerId =
            await AuthStorageService.GetCustomerIdAsync();


        if (customerId.HasValue)
        {
            DashboardUrl =
                "/customer-dashboard";
        }
        else
        {
            DashboardUrl =
                "/staff-dashboard";
        }
    }


    private async Task Logout()
    {
        await AuthenticationService.LogoutAsync();

        IsLoggedIn = false;

        Navigation.NavigateTo("/login");
    }
}

