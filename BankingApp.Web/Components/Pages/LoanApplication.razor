@page "/loan-application/{SelectedLoanType}"
@rendermode InteractiveServer

@using BankingApp.Web.Constants
@using BankingApp.Web.Models.Loan
@using BankingApp.Web.Services.Loan
@using Microsoft.AspNetCore.Components.Forms

<div class="container py-5">

    <!-- HEADER -->
    <div class="mb-4">

        <button class="btn btn-outline-secondary mb-3"
                @onclick="GoBack">
            ← Back
        </button>

        <h2 class="fw-bold">
            Loan Application
        </h2>

        <p class="text-muted">
            Complete the details below to submit your loan application.
        </p>

    </div>

    <!-- LOAN TYPE -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                Loan Type
            </h5>

            <div class="alert alert-light border mb-0">
                <strong>
                    @GetLoanTypeName()
                </strong>
            </div>

        </div>
    </div>

    <!-- LOAN DETAILS -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">
                Loan Details
            </h5>

            <div class="row g-4">

                <!-- LOAN AMOUNT -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Loan Amount
                    </label>

                    <InputNumber @bind-Value="loanApplication.LoanAmount"
                                 class="form-control"
                                 placeholder="Enter loan amount" />

                    <small class="text-muted">
                        Enter the amount you want to borrow.
                    </small>

                </div>

                <!-- TENURE -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Tenure
                    </label>

                    <InputNumber @bind-Value="loanApplication.TenureMonths"
                                 class="form-control"
                                 placeholder="Enter tenure in months" />

                    <small class="text-muted">
                        Enter the repayment period in months.
                    </small>

                </div>

            </div>

        </div>
    </div>

    <!-- REQUIRED DOCUMENTS -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-1">
                Required Documents
            </h5>

            <p class="text-muted mb-4">
                Upload all three required documents.
            </p>

            <!-- SALARY SLIP -->
            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Salary Slip
                </label>

                <InputFile OnChange="OnSalarySlipSelected"
                           class="form-control"
                           accept=".pdf,.jpg,.jpeg,.png" />

                @if (loanApplication.SalarySlip != null)
                {
                    <div class="mt-2 d-flex align-items-center">

                        <span class="text-success">
                            ✓ @loanApplication.SalarySlip.Name
                        </span>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger ms-3"
                                @onclick="RemoveSalarySlip">
                            Remove
                        </button>

                    </div>
                }

            </div>

            <!-- BANK STATEMENT -->
            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Bank Statement
                </label>

                <InputFile OnChange="OnBankStatementSelected"
                           class="form-control"
                           accept=".pdf,.jpg,.jpeg,.png" />

                @if (loanApplication.BankStatement != null)
                {
                    <div class="mt-2 d-flex align-items-center">

                        <span class="text-success">
                            ✓ @loanApplication.BankStatement.Name
                        </span>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger ms-3"
                                @onclick="RemoveBankStatement">
                            Remove
                        </button>

                    </div>
                }

            </div>

            <!-- EMPLOYMENT LETTER -->
            <div class="mb-2">

                <label class="form-label fw-semibold">
                    Employment Letter
                </label>

                <InputFile OnChange="OnEmploymentLetterSelected"
                           class="form-control"
                           accept=".pdf,.jpg,.jpeg,.png" />

                @if (loanApplication.EmploymentLetter != null)
                {
                    <div class="mt-2 d-flex align-items-center">

                        <span class="text-success">
                            ✓ @loanApplication.EmploymentLetter.Name
                        </span>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger ms-3"
                                @onclick="RemoveEmploymentLetter">
                            Remove
                        </button>

                    </div>
                }

            </div>

            @if (!string.IsNullOrWhiteSpace(FileErrorMessage))
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @FileErrorMessage
                </div>
            }

        </div>
    </div>

    <!-- SUBMIT -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            @if (!CanSubmit)
            {
                <div class="alert alert-warning">
                    Please enter the loan amount, tenure and upload all
                    required documents before submitting.
                </div>
            }

            <div class="d-flex justify-content-end">

                <button type="button"
                        class="btn btn-primary px-4"
                        disabled="@(!CanSubmit || IsSubmitting)"
                        @onclick="SubmitApplication">

                    @if (IsSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2">
                        </span>

                        <span>
                            Submitting...
                        </span>
                    }
                    else
                    {
                        <span>
                            Submit Loan Application
                        </span>
                    }

                </button>

            </div>

        </div>

    </div>

</div>

@code {

    // -----------------------------
    // ROUTE PARAMETER
    // -----------------------------

    [Parameter]
    public string? SelectedLoanType { get; set; }


    // -----------------------------
    // SERVICES
    // -----------------------------

    [Inject]
    private ILoanService LoanService { get; set; } = null!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;


    // -----------------------------
    // LOAN DATA
    // -----------------------------

    private LoanType loanType;

    private LoanApplicationRequest loanApplication = new();


    // -----------------------------
    // UI STATE
    // -----------------------------

    private bool IsSubmitting;

    private string? FileErrorMessage;


    // -----------------------------
    // FILE SIZE
    // -----------------------------

    private const long MaxFileSize =
        10 * 1024 * 1024;


    // -----------------------------
    // INITIALIZATION
    // -----------------------------

    protected override void OnInitialized()
    {
        if (!Enum.TryParse<LoanType>(
                SelectedLoanType,
                true,
                out var parsedLoanType))
        {
            NavigationManager.NavigateTo("/apply-loan");

            return;
        }

        loanType = parsedLoanType;

        loanApplication.LoanType =
            loanType;
    }


    // -----------------------------
    // DOCUMENT UPLOAD
    // -----------------------------

    private async Task OnSalarySlipSelected(
        InputFileChangeEventArgs e)
    {
        FileErrorMessage = null;

        loanApplication.SalarySlip =
            await CreateLoanDocument(e.File);
    }


    private async Task OnBankStatementSelected(
        InputFileChangeEventArgs e)
    {
        FileErrorMessage = null;

        loanApplication.BankStatement =
            await CreateLoanDocument(e.File);
    }


    private async Task OnEmploymentLetterSelected(
        InputFileChangeEventArgs e)
    {
        FileErrorMessage = null;

        loanApplication.EmploymentLetter =
            await CreateLoanDocument(e.File);
    }


    private async Task<LoanDocument?> CreateLoanDocument(
        IBrowserFile file)
    {
        try
        {
            if (file.Size > MaxFileSize)
            {
                FileErrorMessage =
                    $"{file.Name} exceeds the maximum file size of 10 MB.";

                return null;
            }

            await using var stream =
                file.OpenReadStream(MaxFileSize);

            using var memoryStream =
                new MemoryStream();

            await stream.CopyToAsync(
                memoryStream);

            return new LoanDocument
            {
                Name = file.Name,

                ContentType = file.ContentType,

                Size = file.Size,

                Content = memoryStream.ToArray()
            };
        }
        catch
        {
            FileErrorMessage =
                $"Unable to read {file.Name}. Please try again.";

            return null;
        }
    }


    // -----------------------------
    // REMOVE DOCUMENTS
    // -----------------------------

    private void RemoveSalarySlip()
    {
        loanApplication.SalarySlip = null;
    }


    private void RemoveBankStatement()
    {
        loanApplication.BankStatement = null;
    }


    private void RemoveEmploymentLetter()
    {
        loanApplication.EmploymentLetter = null;
    }


    // -----------------------------
    // VALIDATION
    // -----------------------------

    private bool CanSubmit =>
        loanApplication.LoanAmount > 0 &&
        loanApplication.TenureMonths > 0 &&
        loanApplication.SalarySlip != null &&
        loanApplication.BankStatement != null &&
        loanApplication.EmploymentLetter != null;


    // -----------------------------
    // SUBMIT APPLICATION
    // -----------------------------

    private async Task SubmitApplication()
    {
        if (!CanSubmit)
        {
            return;
        }

        IsSubmitting = true;

        FileErrorMessage = null;

        try
        {
            var isSubmitted =
                await LoanService.SubmitLoanApplicationAsync(
                    loanApplication);

            if (!isSubmitted)
            {
                FileErrorMessage =
                    "Unable to submit the loan application. Please try again.";
            }
            else
            {
                // Temporary success handling.
                // We can replace this with a proper
                // success page/message later.

                NavigationManager.NavigateTo(
                    "/customer-dashboard");
            }
        }
        catch
        {
            FileErrorMessage =
                "An unexpected error occurred while submitting the loan application.";
        }
        finally
        {
            IsSubmitting = false;
        }
    }


    // -----------------------------
    // LOAN TYPE DISPLAY
    // -----------------------------

    private string GetLoanTypeName()
    {
        return loanType switch
        {
            LoanType.Personal =>
                "Personal Loan",

            LoanType.Home =>
                "Home Loan",

            LoanType.Education =>
                "Education Loan",

            LoanType.Vehicle =>
                "Vehicle Loan",

            _ =>
                "Loan"
        };
    }


    // -----------------------------
    // NAVIGATION
    // -----------------------------

    private void GoBack()
    {
        NavigationManager.NavigateTo(
            "/apply-loan");
    }
}