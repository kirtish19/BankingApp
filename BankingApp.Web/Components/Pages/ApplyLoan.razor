
@page "/apply-loan"

@using BankingApp.Web.Constants

@inject NavigationManager Navigation

<PageTitle>Apply for Loan | BankingApp</PageTitle>

<div class="container py-4">

    <div class="mb-4">

        <button class="btn btn-link
            text-decoration-none
            p-0 mb-3"
                @onclick="GoBack">

            ← Back to Dashboard

        </button>


        <h2 class="fw-bold">
            Choose a Loan
        </h2>

        <p class="text-muted">
            Select the loan product you would like to apply for.
        </p>

    </div>


    <div class="row g-4">

        @foreach (var loan in LoanTypes)
        {
            <div class="col-md-6 col-lg-3">

                <div class="card border-0
                    shadow-sm
                    h-100">

                    <div class="card-body
                        d-flex
                        flex-column">

                        <div class="fs-1 mb-3">
                            @loan.Icon
                        </div>

                        <h5 class="fw-bold">
                            @loan.Name
                        </h5>

                        <p class="text-muted flex-grow-1">
                            @loan.Description
                        </p>

                        <button class="btn btn-outline-primary
                            w-100"
                                @onclick="() => SelectLoan(loan.Type)">

                            Apply

                        </button>

                    </div>

                </div>

            </div>
        }

    </div>

</div>


@code {

    private readonly List<LoanOption> LoanTypes =
    [
        new(
            LoanType.Personal,
            "Personal Loan",
            "For your personal financial needs.",
            "💰"),

        new(
            LoanType.Home,
            "Home Loan",
            "Finance your dream home.",
            "🏠"),

        new(
            LoanType.Vehicle,
            "Vehicle Loan",
            "Finance your new or used vehicle.",
            "🚗"),

        new(
            LoanType.Education,
            "Education Loan",
            "Invest in your education and future.",
            "🎓")
    ];


    private void SelectLoan(LoanType loanType)
    {
        Navigation.NavigateTo(
            $"/loan-application/{loanType}");
    }


    private void GoBack()
    {
        Navigation.NavigateTo(
            "/customer-dashboard");
    }


    private record LoanOption(
        LoanType Type,
        string Name,
        string Description,
        string Icon);
}

