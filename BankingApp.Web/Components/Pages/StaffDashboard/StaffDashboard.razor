@page "/staff-dashboard"

@using System.Globalization
@using BankingApp.Web.Constants
@using BankingApp.Web.Models.Loan
@using BankingApp.Web.Services.Authentication
@using BankingApp.Web.Services.Staff

@rendermode InteractiveServer

<PageTitle>Staff Dashboard | BankingApp</PageTitle>

<div class="container py-4">

    <!-- HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Staff Dashboard</h2>
            <p class="text-muted mb-0">
                Review and manage customer loan applications.
            </p>
        </div>

        <button class="btn btn-outline-danger" @onclick="Logout">
            Logout
        </button>
    </div>


    <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-5">

        <!-- Total Applications -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        Total Applications
                    </small>

                    <h3 class="fw-bold mt-2 mb-1">
                        @AllLoans.Count
                    </h3>

                    <small class="text-muted">
                        All loan applications
                    </small>
                </div>
            </div>
        </div>


        <!-- Pending Applications -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        Pending Applications
                    </small>

                    <h3 class="fw-bold mt-2 mb-1">
                        @PendingLoans.Count
                    </h3>

                    <small class="text-muted">
                        Applications requiring review
                    </small>
                </div>
            </div>
        </div>


        <!-- Approved Applications -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        Approved Applications
                    </small>

                    <h3 class="fw-bold mt-2 mb-1">
                        @ApprovedLoanCount
                    </h3>

                    <small class="text-muted">
                        Approved loan applications
                    </small>
                </div>
            </div>
        </div>

    </div>


    <!-- ERROR MESSAGE -->
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger mb-4">
            @ErrorMessage
        </div>
    }


    <!-- LOADING -->
    @if (IsLoading)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <div class="spinner-border mb-3"></div>

                <p class="text-muted mb-0">
                    Loading loan applications...
                </p>

            </div>
        </div>
    }
    else
    {
        <!-- ============================================ -->
        <!-- ALL LOAN APPLICATIONS -->
        <!-- ============================================ -->

        <div class="card border-0 shadow-sm mb-5">

            <div class="card-body p-4">

                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">

                    <div>
                        <h5 class="fw-bold mb-1">
                            All Loan Applications
                        </h5>

                        <small class="text-muted">
                            View all customer loan applications.
                        </small>
                    </div>

                    <!-- STATUS FILTER -->
                    <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">

                        <label class="fw-semibold mb-0">
                            Filter:
                        </label>

                        <select class="form-select"
                                style="width: 180px;"
                                @bind="SelectedStatus">

                            <option value="">
                                All Statuses
                            </option>

                            <option value="@LoanStatus.Submitted">
                                Submitted
                            </option>

                            <option value="@LoanStatus.Approved">
                                Approved
                            </option>

                            <option value="@LoanStatus.Rejected">
                                Rejected
                            </option>

                            <option value="@LoanStatus.ManualReview">
                                Manual Review
                            </option>

                        </select>

                    </div>

                </div>


                @if (FilteredAllLoans.Count == 0)
                {
                    <div class="text-center py-5 text-muted">

                        <div class="fs-1 mb-2">
                            -
                        </div>

                        <p class="mb-0">
                            No loan applications found for the selected status.
                        </p>

                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Customer</th>
                                    <th>Email</th>
                                    <th>Loan Type</th>
                                    <th>Amount</th>
                                    <th>Tenure</th>
                                    <th>Risk</th>
                                    <th>Status</th>
                                    <th>Applied On</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var (loan, index) in FilteredAllLoans.Select((loan, index) => (loan, index)))
                                {
                                    <tr>

                                        <!-- Row Number -->
                                        <td>
                                            @(index + 1)
                                        </td>

                                        <!-- Customer Name -->
                                        <td class="fw-semibold">
                                            @GetCustomerName(loan.CustomerId)
                                        </td>

                                        <!-- Customer Email -->
                                        <td>
                                            @GetCustomerEmail(loan.CustomerId)
                                        </td>

                                        <!-- Loan Type -->
                                        <td class="fw-semibold">
                                            @GetLoanTypeName(loan.LoanType)
                                        </td>

                                        <!-- Amount -->
                                        <td>
                                            @loan.LoanAmount.ToString("C2", new CultureInfo("en-IN"))
                                        </td>

                                        <!-- Tenure -->
                                        <td>
                                            @loan.TenureMonths months
                                        </td>

                                        <!-- Risk -->
                                        <td>
                                            <span class="@GetRiskClass(loan.RiskAssesmentScore)">
                                                @GetRiskText(loan.RiskAssesmentScore)
                                            </span>
                                        </td>

                                        <!-- Status -->
                                        <td>
                                            <span class="@GetStatusClass(loan.Status)">
                                                @loan.Status
                                            </span>
                                        </td>

                                        <!-- Created Date -->
                                        <td>
                                            @loan.CreatedDate.ToString("dd MMM yyyy")
                                        </td>

                                        <!-- Action -->
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => ReviewLoan(loan.Id)">
                                                View
                                            </button>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>


        <!-- ============================================ -->
        <!-- PENDING LOAN APPLICATIONS -->
        <!-- ============================================ -->

        <div class="card border-0 shadow-sm mb-5">

            <div class="card-body p-4">

                <div class="mb-3">
                    <h5 class="fw-bold mb-1">
                        Pending Loan Applications
                    </h5>

                    <small class="text-muted">
                        Review applications requiring staff action.
                    </small>
                </div>


                @if (PendingLoans.Count == 0)
                {
                    <div class="text-center py-5 text-muted">

                        <div class="fs-1 mb-2">
                            ✓
                        </div>

                        <p class="mb-0">
                            No pending loan applications.
                        </p>

                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Customer</th>
                                    <th>Email</th>
                                    <th>Loan Type</th>
                                    <th>Amount</th>
                                    <th>Tenure</th>
                                    <th>Risk</th>
                                    <th>Status</th>
                                    <th>Applied On</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var (loan, index) in PendingLoans.Select((loan, index) => (loan, index)))
                                {
                                    <tr>

                                        <!-- Row Number -->
                                        <td>
                                            @(index + 1)
                                        </td>

                                        <!-- Customer Name -->
                                        <td class="fw-semibold">
                                            @GetCustomerName(loan.CustomerId)
                                        </td>

                                        <!-- Customer Email -->
                                        <td>
                                            @GetCustomerEmail(loan.CustomerId)
                                        </td>

                                        <!-- Loan Type -->
                                        <td class="fw-semibold">
                                            @GetLoanTypeName(loan.LoanType)
                                        </td>

                                        <!-- Amount -->
                                        <td>
                                            @loan.LoanAmount.ToString("C2", new CultureInfo("en-IN"))
                                        </td>

                                        <!-- Tenure -->
                                        <td>
                                            @loan.TenureMonths months
                                        </td>

                                        <!-- Risk -->
                                        <td>
                                            <span class="@GetRiskClass(loan.RiskAssesmentScore)">
                                                @GetRiskText(loan.RiskAssesmentScore)
                                            </span>
                                        </td>

                                        <!-- Status -->
                                        <td>
                                            <span class="@GetStatusClass(loan.Status)">
                                                @loan.Status
                                            </span>
                                        </td>

                                        <!-- Created Date -->
                                        <td>
                                            @loan.CreatedDate.ToString("dd MMM yyyy")
                                        </td>

                                        <!-- Action -->
                                        <td>
                                            <button class="btn btn-sm btn-primary"
                                                    @onclick="() => ReviewLoan(loan.Id)">
                                                Review
                                            </button>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>
    }

</div>