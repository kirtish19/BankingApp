@page "/customer-dashboard"
@rendermode InteractiveServer

@inject NavigationManager Navigation

<PageTitle>Customer Dashboard | BankingApp</PageTitle>

<div class="container py-4">

    <!-- ========================================= -->
    <!-- HEADER -->
    <!-- ========================================= -->

    <div class="d-flex
        flex-wrap
        justify-content-between
        align-items-center
        mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Welcome back!
            </h2>

            <p class="text-muted mb-0">
                Manage your banking services and applications.
            </p>

        </div>

        <button class="btn btn-outline-danger"
                @onclick="Logout">

            Logout

        </button>

    </div>


    <!-- ========================================= -->
    <!-- ACCOUNT STATUS -->
    <!-- ========================================= -->

    <div class="row g-4 mb-4">

        <!-- KYC -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        KYC Status
                    </small>

                    <h4 class="fw-bold text-success mt-2">
                        ✓ Approved
                    </h4>

                    <small class="text-muted">
                        Your account is active.
                    </small>

                </div>

            </div>

        </div>


        <!-- ACTIVE LOANS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Active Loans
                    </small>

                    <h4 class="fw-bold mt-2">
                        0
                    </h4>

                    <small class="text-muted">
                        No active loans.
                    </small>

                </div>

            </div>

        </div>


        <!-- APPLICATIONS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Loan Applications
                    </small>

                    <h4 class="fw-bold mt-2">
                        0
                    </h4>

                    <small class="text-muted">
                        No applications yet.
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- APPLY FOR LOAN -->
    <!-- ========================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <span class="badge bg-primary mb-2">
                        Loans
                    </span>

                    <h4 class="fw-bold">
                        Apply for a Loan
                    </h4>

                    <p class="text-muted mb-0">
                        Choose a loan product and submit
                        your application online.
                    </p>

                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                    <button class="btn btn-primary px-4"
                            @onclick="GoToLoans">

                        Explore Loans

                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- RECENT APPLICATIONS -->
    <!-- ========================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                Recent Applications
            </h5>

            <div class="text-center py-5 text-muted">

                <div class="fs-1 mb-2">
                    📄
                </div>

                <p class="mb-0">
                    No loan applications yet.
                </p>

            </div>

        </div>

    </div>

</div>


@code {

    private void GoToLoans()
    {
        Navigation.NavigateTo("/apply-loan");
    }

    private void Logout()
    {
        Navigation.NavigateTo("/login");
    }
}

