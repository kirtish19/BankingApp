@page "/register"
@rendermode InteractiveServer
@using BankingApp.Web.Constants

<PageTitle>Register - BankingApp</PageTitle>

<div class="container py-4 py-md-5">

    <div class="row justify-content-center">

        <div class="col-12 col-xl-9">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-5">

                        <h2 class="fw-bold">
                            Create Your Account
                        </h2>

                        <p class="text-muted">
                            Register with BankingApp
                        </p>

                    </div>


                    <EditForm EditContext="@editContext"
                              OnValidSubmit="@HandleSubmit">

                        <FluentValidationValidator />


                        <!-- ============================= -->
                        <!-- ACCOUNT TYPE -->
                        <!-- ============================= -->

                        <section class="mb-5">

                            <h5 class="fw-semibold mb-3">
                                Account Type
                            </h5>

                            <div class="row g-3">

                                <div class="col-12 col-md-6">

                                    <div class="form-check border rounded p-3">

                                        <input class="form-check-input"
                                               type="radio"
                                               name="userType"
                                               checked="@(registrationRequest.UserType == UserType.Customer)"
                                               @onchange="SelectCustomer" />

                                        <label class="form-check-label">

                                            <strong>
                                                Customer
                                            </strong>

                                            <span class="d-block text-muted small">
                                                Create a personal banking account.
                                            </span>

                                        </label>

                                    </div>

                                </div>


                                <div class="col-12 col-md-6">

                                    <div class="form-check border rounded p-3">

                                        <input class="form-check-input"
                                               type="radio"
                                               name="userType"
                                               checked="@(registrationRequest.UserType == UserType.Staff)"
                                               @onchange="SelectStaff" />

                                        <label class="form-check-label">

                                            <strong>
                                                Staff
                                            </strong>

                                            <span class="d-block text-muted small">
                                                Create a bank staff account.
                                            </span>

                                        </label>

                                    </div>

                                </div>

                            </div>

                        </section>


                        <!-- ============================= -->
                        <!-- ACCOUNT INFORMATION -->
                        <!-- ============================= -->

                        <section class="mb-5">

                            <h5 class="fw-semibold mb-4">
                                Account Information
                            </h5>

                            <div class="row g-3">

                                <div class="col-12">

                                    <label class="form-label">
                                        Username
                                    </label>

                                    <InputText class="form-control"
                                               @bind-Value="registrationRequest.UserName"
                                               placeholder="Enter username" />

                                    <ValidationMessage
                                        For="@(() => registrationRequest.UserName)"
                                        class="text-danger small" />

                                </div>


                                <div class="col-12 col-md-6">

                                    <label class="form-label">
                                        Login Password
                                    </label>

                                    <InputText type="password"
                                               class="form-control"
                                               @bind-Value="registrationRequest.LoginPassword"
                                               placeholder="Enter login password" />

                                    <ValidationMessage
                                        For="@(() => registrationRequest.LoginPassword)"
                                        class="text-danger small" />

                                </div>


                                <div class="col-12 col-md-6">

                                    <label class="form-label">
                                        Confirm Login Password
                                    </label>

                                    <InputText type="password"
                                               class="form-control"
                                               @bind-Value="registrationRequest.ConfirmLoginPassword"
                                               placeholder="Confirm login password" />

                                    <ValidationMessage
                                        For="@(() => registrationRequest.ConfirmLoginPassword)"
                                        class="text-danger small" />

                                </div>


                                <div class="col-12 col-md-6">

                                    <label class="form-label">
                                        Profile Password
                                    </label>

                                    <InputText type="password"
                                               class="form-control"
                                               @bind-Value="registrationRequest.ProfilePassword"
                                               placeholder="Enter profile password" />

                                    <ValidationMessage
                                        For="@(() => registrationRequest.ProfilePassword)"
                                        class="text-danger small" />

                                </div>


                                <div class="col-12 col-md-6">

                                    <label class="form-label">
                                        Confirm Profile Password
                                    </label>

                                    <InputText type="password"
                                               class="form-control"
                                               @bind-Value="registrationRequest.ConfirmProfilePassword"
                                               placeholder="Confirm profile password" />

                                    <ValidationMessage
                                        For="@(() => registrationRequest.ConfirmProfilePassword)"
                                        class="text-danger small" />

                                </div>

                            </div>

                        </section>


                        @if (registrationRequest.UserType == UserType.Customer)
                        {
                            <!-- ============================= -->
                            <!-- PERSONAL INFORMATION -->
                            <!-- ============================= -->

                            <section class="mb-5">

                                <h5 class="fw-semibold mb-4">
                                    Personal Information
                                </h5>

                                <div class="row g-3">

                                    <div class="col-12 col-md-6">

                                        <label class="form-label">
                                            First Name
                                        </label>

                                        <InputText class="form-control"
                                                   @bind-Value="registrationRequest.FirstName" />

                                        <ValidationMessage
                                            For="@(() => registrationRequest.FirstName)"
                                            class="text-danger small" />

                                    </div>


                                    <div class="col-12 col-md-6">

                                        <label class="form-label">
                                            Last Name
                                        </label>

                                        <InputText class="form-control"
                                                   @bind-Value="registrationRequest.LastName" />

                                        <ValidationMessage
                                            For="@(() => registrationRequest.LastName)"
                                            class="text-danger small" />

                                    </div>


                                    <div class="col-12 col-md-6">

                                        <label class="form-label">
                                            Email
                                        </label>

                                        <InputText type="email"
                                                   class="form-control"
                                                   @bind-Value="registrationRequest.Email" />

                                        <ValidationMessage
                                            For="@(() => registrationRequest.Email)"
                                            class="text-danger small" />

                                    </div>


                                    <div class="col-12 col-md-6">

                                        <label class="form-label">
                                            Mobile Number
                                        </label>

                                        <InputText class="form-control"
                                                   @bind-Value="registrationRequest.MobileNumber" />

                                        <ValidationMessage
                                            For="@(() => registrationRequest.MobileNumber)"
                                            class="text-danger small" />

                                    </div>


                                    <div class="col-12 col-md-6">

                                        <label class="form-label">
                                            Date of Birth
                                        </label>

                                        <InputDate class="form-control"
                                                   @bind-Value="registrationRequest.DateOfBirth" />

                                        <ValidationMessage
                                            For="@(() => registrationRequest.DateOfBirth)"
                                            class="text-danger small" />

                                    </div>

                                </div>

                            </section>


                            <!-- ============================= -->
                            <!-- EMPLOYMENT -->
                            <!-- ============================= -->

                            <section class="mb-5">

                                <h5 class="fw-semibold mb-4">
                                    Employment & Financial Information
                                </h5>

                                <div class="row g-3">

                                    <div class="col-12 col-md-6">

                                        <label class="form-label">
                                            Employment Type
                                        </label>

                                        <InputSelect class="form-select"
                                                     @bind-Value="registrationRequest.EmploymentType">

                                            @foreach (var type in
                                                Enum.GetValues<EmploymentType>())
                                            {
                                                <option value="@type">
                                                    @GetEmploymentDisplayName(type)
                                                </option>
                                            }

                                        </InputSelect>

                                        <ValidationMessage
                                            For="@(() => registrationRequest.EmploymentType)"
                                            class="text-danger small" />

                                    </div>


                                    <div class="col-12 col-md-6">

                                        <label class="form-label">
                                            Annual Income
                                        </label>

                                        <InputNumber class="form-control"
                                                     @bind-Value="registrationRequest.AnnualIncome" />

                                        <ValidationMessage
                                            For="@(() => registrationRequest.AnnualIncome)"
                                            class="text-danger small" />

                                    </div>


                                    <div class="col-12 col-md-6">

                                        <label class="form-label">
                                            Credit Score
                                        </label>

                                        <InputNumber class="form-control"
                                                     @bind-Value="registrationRequest.CreditScore" />

                                        <ValidationMessage
                                            For="@(() => registrationRequest.CreditScore)"
                                            class="text-danger small" />

                                    </div>

                                </div>

                            </section>


                            <!-- ============================= -->
                            <!-- KYC -->
                            <!-- ============================= -->

                            <section class="mb-5">

                                <h5 class="fw-semibold mb-3">
                                    KYC Documents
                                </h5>

                                <p class="text-muted small">
                                    Add your KYC documents one at a time.
                                </p>


                                <div class="card bg-light border-0">

                                    <div class="card-body">

                                        <div class="row g-3 align-items-end">

                                            <div class="col-12 col-md-9">

                                                <InputFile
                                                    OnChange="HandleKycFileSelected"
                                                    accept=".pdf,.jpg,.jpeg,.png"
                                                    class="form-control" />

                                                <div class="form-text">
                                                    PDF, JPG or PNG. Maximum 10 MB.
                                                </div>

                                            </div>


                                            <div class="col-12 col-md-3">

                                                <button type="button"
                                                        class="btn btn-primary w-100"
                                                        @onclick="AddKycDocument"
                                                        disabled="@(selectedKycFile is null)">

                                                    Add Document

                                                </button>

                                            </div>

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(kycErrorMessage))
                                        {
                                            <div class="alert alert-danger mt-3">
                                                @kycErrorMessage
                                            </div>
                                        }

                                    </div>

                                </div>


                                @if (registrationRequest.KycDocuments.Count > 0)
                                {
                                    <div class="mt-4">

                                        <h6 class="fw-semibold">
                                            Added Documents
                                        </h6>

                                        <div class="list-group mt-3">

                                            @foreach (var document in
                                                registrationRequest.KycDocuments)
                                            {
                                                <div class="list-group-item">

                                                    <div class="d-flex justify-content-between align-items-center">

                                                        <div>

                                                            <div class="fw-semibold">
                                                                @document.Name
                                                            </div>

                                                            <small class="text-muted">
                                                                @FormatFileSize(document.Size)
                                                            </small>

                                                        </div>


                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-danger"
                                                                @onclick="() => RemoveKycDocument(document)">

                                                            Remove

                                                        </button>

                                                    </div>

                                                </div>
                                            }

                                        </div>

                                    </div>
                                }


                                <ValidationMessage
                                    For="@(() => registrationRequest.KycDocuments)"
                                    class="text-danger small" />

                            </section>
                        }


                        <!-- ============================= -->
                        <!-- RESULT -->
                        <!-- ============================= -->

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert alert-danger">
                                @errorMessage
                            </div>
                        }


                        @if (registrationSuccessful)
                        {
                            <div class="alert alert-success">
                                Registration submitted successfully.
                            </div>
                        }


                        <!-- ============================= -->
                        <!-- ACTIONS -->
                        <!-- ============================= -->

                        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">

                            <a href="/login"
                               class="btn btn-outline-secondary px-4">
                                Back to Login
                            </a>


                            <button type="submit"
                                    class="btn btn-primary px-4"
                                    disabled="@isSubmitting">

                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Registering...</span>
                                }
                                else
                                {
                                    <span>Create Account</span>
                                }

                            </button>

                        </div>

                    </EditForm>

                </div>

            </div>

        </div>

    </div>

</div>


